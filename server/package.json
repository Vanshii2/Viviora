{
  "name": "viviora-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.8",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
