# Root reference of every environment variable used by Viviora.
# Real values go in server/.env and client/.env (never committed).

# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://vansh123:vansh123@cluster0.h3i0dln.mongodb.net/

# Authentication (Phase 3)
JWT_SECRET=
OTP_PROVIDER_API_KEY=

# Razorpay (Phase 5)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI provider (Phase 4)
AI_PROVIDER=mock
AI_API_KEY=

# Cloud storage (Phase 6)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Client (Vite only exposes VITE_* variables to the browser — never put secrets here)
VITE_API_URL=/api/v1
